@charset "utf-8";

.vue-notification-group { display: block; position: fixed; z-index: 5000; }

.vue-notification-wrapper { display: block; overflow: hidden; width: 100%; margin: 0px; padding: 0px; }

.notification-title { font-weight: 600; }

.vue-notification-template { display: block; box-sizing: border-box; background: rgb(255, 255, 255); text-align: left; }

.vue-notification { display: block; box-sizing: border-box; text-align: left; font-size: 12px; padding: 10px; margin: 0px 5px 5px; color: rgb(255, 255, 255); background: rgb(68, 164, 252); border-left: 5px solid rgb(24, 127, 231); }

.vue-notification.warn { background: rgb(255, 182, 72); border-left-color: rgb(244, 138, 6); }

.vue-notification.error { background: rgb(229, 77, 66); border-left-color: rgb(184, 46, 36); }

.vue-notification.success { background: rgb(104, 205, 134); border-left-color: rgb(66, 168, 95); }

.vn-fade-enter-active, .vn-fade-leave-active, .vn-fade-move { transition: 0.5s; }

.vn-fade-enter-from, .vn-fade-leave-to { opacity: 0; }
