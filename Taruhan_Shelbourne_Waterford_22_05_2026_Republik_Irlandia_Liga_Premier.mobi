.rtl { direction: rtl; }

.vdp-datepicker { text-align: left; }

.vdp-datepicker * { box-sizing: border-box; }

.vdp-datepicker__calendar { position: absolute; width: 18.75rem; z-index: 10000; }

.vdp-datepicker__calendar header { min-height: 2rem; width: 100%; }

.vdp-datepicker__calendar header span { align-items: center; display: flex; float: left; justify-content: center; min-height: inherit; transition: background-color 0.3s, color 0.3s; width: 71.4286%; }

.vdp-datepicker__calendar header .prev::after { border-right: 0.625rem solid rgb(0, 0, 0); margin-left: -0.3125rem; }

.vdp-datepicker__calendar header .prev.disabled::after { border-right: 0.625rem solid rgb(221, 221, 221); }

.vdp-datepicker__calendar header .next::after { border-left: 0.625rem solid rgb(0, 0, 0); margin-left: 0.3125rem; }

.vdp-datepicker__calendar header .next.disabled::after { border-left: 0.625rem solid rgb(221, 221, 221); }

.vdp-datepicker__calendar .disabled { color: rgb(221, 221, 221); cursor: default; }

.vdp-datepicker__calendar .cell { border: 1px solid transparent; display: inline-block; height: 2.5rem; line-height: 2.5rem; padding: 0px 0.3125rem; text-align: center; transition: background-color 0.3s, color 0.3s, border-radius 0.3s; vertical-align: middle; width: 14.2857%; }

